# ─── Web Platform ────────────────────────────────
SECRET_KEY=change-me-to-a-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ─── OpenWeatherMap ──────────────────────────────
OPENWEATHERMAP_API_KEY=

# ─── Telegram MusicBot ───────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── VK Music ────────────────────────────────────
VK_TOKEN=
VK_LOGIN=
VK_PASSWORD=

# ─── Spotify ─────────────────────────────────────
# Optional: metadata only (tracks download via YouTube); its release lengths
# help pick the studio version. App at https://developer.spotify.com/dashboard
# (Web API). Since 2026-02 a Development Mode app needs the owner to have
# Spotify Premium, and search returns at most 10 results per request.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── AcoustID (audio recognition) ────────────────
ACOUSTID_API_KEY=

# ─── Limits ──────────────────────────────────────
MAX_FILE_SIZE_MB=49
DOWNLOAD_DIR=/tmp/musicbot

# ─── Local Bot API server (optional, for big audiobooks) ──
# Leave empty to use Telegram's cloud API (50 MB send limit → books are split).
# Set to your self-hosted telegram-bot-api to send whole files up to 2 GB,
# e.g. http://telegram-bot-api:8081
TELEGRAM_API_BASE_URL=

# ─── Audiobooks ──────────────────────────────────
AUDIOBOOK_BITRATE_KBPS=64
AUDIOBOOK_PART_SIZE_MB=45
